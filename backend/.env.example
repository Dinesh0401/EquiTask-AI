# -----------------------------------------------------------------------------
# EquiTask AI — example environment variables.
#
# Copy this file to `backend/.env` and adjust for your environment.
#
# WARNING: this file contains example values only. Never commit real secrets
# (database passwords, signing keys, API tokens) to version control. The
# `backend/.env` file is gitignored for this reason. Generate production
# secrets with a CSPRNG, e.g.:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# This repository is a research prototype; these settings are NOT production
# hardened. See docs/DEPLOYMENT.md (draft, requires security review).
# -----------------------------------------------------------------------------

# Application
EQUITASK_APP_NAME=EquiTask AI

# Database (SQLite by default; PostgreSQL for Docker Compose and production)
#   sqlite:  EQUITASK_DATABASE_URL=sqlite:///./equitask.db
#   postgres: EQUITASK_DATABASE_URL=postgresql+psycopg2://equitask:changeme@db:5432/equitask
EQUITASK_DATABASE_URL=sqlite:///./equitask.db

# Session / JWT signing secret — MUST be changed before any real deployment
EQUITASK_SECRET_KEY=dev-only-change-me-before-any-real-deployment
EQUITASK_TOKEN_TTL_MINUTES=720
EQUITASK_PASSWORD_ITERATIONS=210000

# Solver (OR-Tools CP-SAT) limits
EQUITASK_SOLVER_TIME_LIMIT_SECONDS=5
EQUITASK_MAX_PROBLEM_VOLUNTEERS=200
EQUITASK_MAX_PROBLEM_TASKS=200

# API rate limiting (per-client, in-process fixed window; use a gateway or
# Redis-backed limiter for multi-instance production deployment)
EQUITASK_REQUEST_RATE_LIMIT=120
EQUITASK_STALE_FIELD_HOURS=336

# Demo seeding — disabled by default. Set "true" only in throwaway dev/staging
# databases. NEVER enable on production data.
EQUITASK_ENABLE_DEMO_SEED=false

# Logging
EQUITASK_LOG_LEVEL=INFO
